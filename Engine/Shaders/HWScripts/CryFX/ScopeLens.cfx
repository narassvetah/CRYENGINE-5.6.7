// ScopeLens v2: процедурный шейдер линзы прицела (CryEngine 5.6, CryFX/HLSL).
// Основа: Glass.cfx (структура, includes, Refractive, чтение копии сцены Fwd_SceneTarget).
//
// Что внутри:
//  - 17 процедурных SDF-сеток (параметр Reticle Type), тумблер %NO_DOT гасит центральную точку на любой сетке
//  - физика линзы: лунная тень (eye relief), параллакс коллиматора, сферическая дисторсия, хроматика, размытие по краям
//  - %SCOPE_RTT: чёткая картинка из второй камеры (render texture в слоте материала) вместо зума кадра
//  - %BROKEN_GLASS: разбитое стекло по карте нормалей (слот Bumpmap): преломление и блеск трещин
//  - зум задаётся через FOV: Scope FOV (во сколько градусов "видит" линза) и Source FOV (FOV камеры, снявшей картинку)
//  - %SCOPE_RTT: чёткая картинка из второй камеры (render texture в слоте Custom) вместо зума кадра
//  - %SPECULAR_MAP: блики солнца на линзе, интенсивность и цвет берутся из карты Specular материала
//  - %BROKEN_GLASS: разбитое стекло по карте нормалей (слот Bumpmap): преломление и блеск трещин
//
// Система координат линзы "p": центр (0,0), край стекла |p| = 1, +X вправо по UV, +Y вверх.
// Система координат сетки "q": q = Rot(p - центр_сетки) / Reticle Scale. Размеры сеток заданы в q.
// Геометрия линзы (метры, положение глаза) восстанавливается из ddx/ddy, тангенты не нужны.

#include "Common.cfi"
#include "ShadowCommon.cfi"

float Script : STANDARDSGLOBAL
<
	string Script =
		"Public;"
		"NoPreview;"
		"SupportsAttrInstancing;"
		"ShaderDrawType = Light;"
		"VertexColors;"
		"Refractive;"
		"ShaderType = Glass;";
>;

#ifndef %VERTCOLORS
#define %VERTCOLORS
#endif

struct CustomForwardShadingAttribs
{
	half  backlightMask;
};

#include "ShadeLib.cfi"
#include "VertexLib.cfi"

// ForwardShading.cfi объявляет Fwd_SceneTarget и требует заранее определённый Callback_ShadingDirect (как в Glass.cfx).
// Линзе освещение от ламп не нужно, поэтому колбэк пустой.
void Callback_ShadingDirect(in ForwardShadingAttribs attribs, in ForwardLightParams light, out float3 diffuseAcc, out float3 specularAcc)
{
	diffuseAcc = 0;
	specularAcc = 0;
}

#include "ForwardShading.cfi"

#if %SCOPE_RTT
// Картинка второй камеры (render texture). Слот Custom в редакторе материалов.
Texture2D scopeRT : register(9)
<
	UIName = "Scope Image (render texture)";
> = TM_Custom;
#endif

#if %SPECULAR_MAP
// Карта Specular материала (тот же слот, что у Glass): где на стекле и каким цветом появляются блики.
Texture2D scopeSpecTex : register(t2)
<
	UIName = "Specular Map";
	sRGBLookup = true;
> = TM_Specular;
#endif

// Константы стекла (раньше были слайдерами; регистры нужны под новые эффекты)
#define SC_TRANSMISSION 0.96
#define SC_RIM          0.06
#define SC_DIRT_SCALE   8.0
// радиус кольца у Circle-Dot, Ring, Ghost Ring, Horseshoe
#define SC_RING_R       0.45
// рост цели для дальномерных шкал, метры
#define SC_TARGET_H     1.7
// толщина тонких линий сетки
#define SC_LINE_W       0.006
// радиус видимой апертуры на оси (лунная тень)
// мягкость края лунной тени
// кривизна стекла для бликов
#define SC_SPEC_CURVE   0.4
// мягкость края и свечения точки
#define SC_DOT_SOFT     0.35
// тайлинг карты трещин по линзе
#define SC_CRACK_TILE   1.0
#define SC_PARALLAX     1.0
#define SC_MIL_SCALE    0.05
#define SC_SPEC_GLOSS   7.0
#define SC_DEBUG        0.0

////////////////////////////////////////////////////////////////////////////////////////////////////
// Параметры материала: 8 регистров = 32 числа, дублей нет.
// Раскладка: R0 сетка, R1 цвет сетки, R2 tint, R3 второй цвет градиента, R4 глаз и FOV, R5 дисторсия и сетка, R6 стекло, R7 блики, трещины, угол градиента.
// Параметры опциональных эффектов объявлены внутри #if (как в стоковой воде), чтобы неиспользуемые регистры не мешали.
// Редко нужные настройки (радиус кольца, рост цели, толщина линий, мягкость точки и тени, кривизна, масштаб карты трещин) стали константами: см. #define выше.

